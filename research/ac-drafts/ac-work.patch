diff --git a/app/src/main/java/com/tj/launcher/BatterySaverGuard.java b/app/src/main/java/com/tj/launcher/BatterySaverGuard.java
new file mode 100644
index 0000000..f537784
--- /dev/null
+++ b/app/src/main/java/com/tj/launcher/BatterySaverGuard.java
@@ -0,0 +1,60 @@
+package com.tj.launcher;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.database.ContentObserver;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.util.Log;
+
+/**
+ * AC3: turns battery saver off the moment it is on while the custom launcher is active. See {@link BatterySaverPolicy} for the why; this class is the Android side (a ContentObserver on
+ * {@code Settings.Global low_power} registered once per process from {@link TjApplication}, plus a check whenever the mode becomes custom). Cheap, exception-safe, never throws.
+ * Quickstep is never touched. Needs the WRITE_SECURE_SETTINGS grant (already part of the adb setup): without it the guard does nothing and says so in its status line.
+ */
+public final class BatterySaverGuard {
+    private static final String TAG = "TjBatSaver";
+    private static final long[] writes = new long[BatterySaverPolicy.MAX_WRITES];
+    private static int writeIdx = 0;
+    private static ContentObserver observer;   // held strongly: the content resolver only keeps a weak reference
+
+    private BatterySaverGuard() {}
+
+    public static boolean enabled(Context c) { return Features.get(c, BatterySaverPolicy.KEY, true); }
+    public static boolean permitted(Context c) { return c.checkSelfPermission("android.permission.WRITE_SECURE_SETTINGS") == android.content.pm.PackageManager.PERMISSION_GRANTED; }
+
+    /** Registers the observer once per process (idempotent) and checks once. Called from {@link TjApplication#onCreate}. */
+    public static synchronized void start(Context c) {
+        try {
+            if (observer != null) return;
+            final Context app = c.getApplicationContext();
+            observer = new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override public void onChange(boolean selfChange) { check(app, "setting changed"); }
+            };
+            app.getContentResolver().registerContentObserver(Settings.Global.getUriFor(BatterySaverPolicy.SETTING), false, observer);
+            check(app, "process start");
+        } catch (Throwable t) { Log.e(TAG, "could not watch battery saver", t); }
+    }
+
+    /** Switches battery saver off now if the rules say so. {@code why} is for the log / status line only. */
+    public static void check(Context c, String why) {
+        try {
+            ContentResolver cr = c.getContentResolver();
+            boolean on = BatterySaverPolicy.isOn(Settings.Global.getString(cr, BatterySaverPolicy.SETTING));
+            if (!on) return;   // the common case costs one settings read
+            long now = System.currentTimeMillis();
+            synchronized (BatterySaverGuard.class) {
+                if (!BatterySaverPolicy.shouldTurnOff(enabled(c), Mode.isCustom(c), CrashGuard.automationOff(c), true, now, writes)) return;
+                if (!permitted(c)) { Features.setString(c, BatterySaverPolicy.LAST_KEY, stamp(now) + "  battery saver is on but the adb permission (WRITE_SECURE_SETTINGS) is missing"); return; }
+                writes[writeIdx++ % writes.length] = now;
+            }
+            Settings.Global.putInt(cr, BatterySaverPolicy.SETTING, 0);
+            if (BatterySaverPolicy.isOn(Settings.Global.getString(cr, BatterySaverPolicy.STICKY_SETTING))) Settings.Global.putInt(cr, BatterySaverPolicy.STICKY_SETTING, 0);
+            Features.setString(c, BatterySaverPolicy.LAST_KEY, stamp(now) + "  switched battery saver off in the custom launcher (" + why + ")");
+            Log.i(TAG, "BATSAVER off (" + why + ")");
+        } catch (Throwable t) { Log.e(TAG, "battery saver check failed", t); }
+    }
+
+    private static String stamp(long ms) { return new java.text.SimpleDateFormat("HH:mm:ss", java.util.Locale.US).format(new java.util.Date(ms)); }
+}
diff --git a/app/src/main/java/com/tj/launcher/BatterySaverPolicy.java b/app/src/main/java/com/tj/launcher/BatterySaverPolicy.java
new file mode 100644
index 0000000..760f30f
--- /dev/null
+++ b/app/src/main/java/com/tj/launcher/BatterySaverPolicy.java
@@ -0,0 +1,35 @@
+package com.tj.launcher;
+
+/**
+ * AC3 (Tj, 2026-11-05 ~22:17): "make it so custom launcher automatically disables battery saver mode. I turned on battery saver from quickstep then went to the custom launcher and it was still on.
+ * I want the custom launcher to turn it off immediately, if possible without any delay, maybe this can be prepped ahead of time".
+ *
+ * The pure rules for {@link BatterySaverGuard} (JVM-tested). Android 10's BatterySaverStateMachine watches {@code Settings.Global low_power}: writing 0 (with the WRITE_SECURE_SETTINGS grant the
+ * launcher already has) switches battery saver off exactly as the Settings screen does. "Prepared ahead of time" = a ContentObserver on that setting registered for the life of the process, so the
+ * write happens the moment something turns it on; nothing polls.
+ */
+public final class BatterySaverPolicy {
+    public static final String KEY = "profile_battery_saver_off";   // switch in Launcher control, default ON (Tj asked for it)
+    public static final String SETTING = "low_power";               // Settings.Global: 1 = battery saver on
+    public static final String STICKY_SETTING = "low_power_sticky"; // Settings.Global: Android keeps it on until the battery recovers; cleared together with the main flag
+    public static final String LAST_KEY = "battery_saver_last";     // what the guard did last (shown in Launcher control and the report)
+    /** At most this many switch-offs per window: a ROM that turns it on again by itself is never fought in a loop. */
+    public static final int MAX_WRITES = 4;
+    public static final long WINDOW_MS = 60_000;
+
+    private BatterySaverPolicy() {}
+
+    /** Pure: is this stored setting value "battery saver on"? */
+    public static boolean isOn(String value) { return value != null && "1".equals(value.trim()); }
+
+    /**
+     * Pure: switch battery saver off now? Only in the custom launcher, only while the switch is on, never while automation is paused (breaker tripped / "Restore everything"),
+     * only when it really is on, and not more than {@link #MAX_WRITES} times per {@link #WINDOW_MS}.
+     */
+    public static boolean shouldTurnOff(boolean switchOn, boolean customMode, boolean automationOff, boolean saverOn, long now, long[] recentWrites) {
+        if (!switchOn || !customMode || automationOff || !saverOn) return false;
+        int n = 0;
+        if (recentWrites != null) for (long t : recentWrites) if (t > 0 && now - t <= WINDOW_MS) n++;
+        return n < MAX_WRITES;
+    }
+}
