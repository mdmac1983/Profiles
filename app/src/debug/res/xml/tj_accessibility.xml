<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (research PWR2): also asks to see hardware key events so the emulator test can tell whether the power key reaches an accessibility service.
     The release build uses app/src/main/res/xml/tj_accessibility.xml (no key capability), so installing an update never changes what the helper is allowed to do. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="0"
    android:description="@string/tj_accessibility_description" />
