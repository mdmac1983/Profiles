<!-- AA2: a fully transparent 24 dp icon (a vector with no path). The keep-alive notification must have a small icon; Android raises a foreground-service notification to at least LOW importance
     (measured, run 79), which shows its icon in the status bar - this one draws nothing, so the status bar stays clean. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24" />
