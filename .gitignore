# The release-signing keystore: NOT a build artifact, deliberately never in git.
# tools/keystore.fingerprint (the SHA-256, not the key) IS committed. See BRIEF.md.
app/sideload.jks

.DS_Store
*.log

# simple-workflow plugin artifacts (local-only; delete entries to share via git)
.simple-workflow/
.simple-workflow
